    fetched: false,
    // 分类配置
    categories: [
      { name: 'rankings', label: '排行榜', icon: '🏆' },
      { name: 'frontend', label: '前端', icon: '💻' },
      { name: 'backend', label: '后端', icon: '⚙️' },
