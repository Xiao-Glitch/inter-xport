      { name: 'career', label: '代码人生', icon: '🚀' },
      { name: 'reading', label: '阅读', icon: '📚' }
    ]
  },
  getters: {
    // 获取所有文章
    getArticleList: state => state.artList,

    // 根据分类获取文章
    getArticlesByCategory: state => category => {
      if (!category || category === 'all') {
        return state.artList
      }
      return state.artList.filter(item => item.category === category)
    },

    // 获取分类配置
    getCategories: state => state.categories,

    // 搜索功能（支持按分类搜索）
    searchList: state => ({ keywords, category = null }) => {
      if (!keywords) {
        // 如果没有关键词，返回该分类下的所有文章
        return category ? state.artList.filter(item => item.category === category) : state.artList
      }

      const kw = keywords.toLowerCase()
      let results = state.artList.filter(item =>
        item.title.toLowerCase().includes(kw) ||
        item.content.toLowerCase().includes(kw)
      )

      // 如果指定了分类，进一步筛选
      if (category) {
        results = results.filter(item => item.category === category)
      }

      return results.slice(0, 10)
    },

    // 获取热门文章（按浏览量排序）
    getHotArticles: state => {
      return [...state.artList].sort((a, b) => {
        const viewsA = parseInt(a.views) || 0
        const viewsB = parseInt(b.views) || 0
        return viewsB - viewsA
      }).slice(0, 10)
    },

    // 获取最新文章
    getLatestArticles: state => {
      return [...state.artList].sort((a, b) => {
        return new Date(b.time) - new Date(a.time)
      }).slice(0, 10)
    },

    hasMore: state => {
      return !state.fetched || state.artList.length === 0
    }
  },

  mutations: {
    // 添加新文章
    ADD_ARTICLE (state, article) {
      const newArticle = {
        id: Date.now(),
        otherId: 1000 + state.artList.length + 1,
        views: '0',
        likes: '0',
        avg: 'http://teachoss.itheima.net/heimaQuestionMiniapp/%E5%AE%98%E6%96%B9%E9%BB%98%E8%AE%A4%E5%A4%B4%E5%83%8F%402x.png',
        time: new Date().toISOString().split('T')[0],
        ...article
      }
      state.artList.unshift(newArticle)
    },

    // 更新文章点赞数
    UPDATE_ARTICLE_LIKES (state, { id, likes }) {
      const article = state.artList.find(item => item.id === id)
      if (article) {
        article.likes = likes.toString()
      }
    },

    // 更新文章浏览量
    UPDATE_ARTICLE_VIEWS (state, { id, views }) {
      const article = state.artList.find(item => item.id === id)
      if (article) {
        article.views = views.toString()
      }
    },

    // 设置获取状态
    SET_FETCHED (state, status) {
      state.fetched = status
    }
  },

  actions: {
    // 添加新文章
    addArticle ({ commit }, article) {
      commit('ADD_ARTICLE', article)
    },

    // 增加文章浏览量
    incrementViews ({ commit, state }, id) {
      const article = state.artList.find(item => item.id === id)
      if (article) {
        const newViews = (parseInt(article.views) || 0) + 1
        commit('UPDATE_ARTICLE_VIEWS', { id, views: newViews })
      }
    },

    // 切换文章点赞状态
    toggleLike ({ commit, state }, id) {
      const article = state.artList.find(item => item.id === id)
      if (article) {
        const currentLikes = parseInt(article.likes) || 0
        const isLiked = article.isLiked
        const newLikes = isLiked ? currentLikes - 1 : currentLikes + 1
        commit('UPDATE_ARTICLE_LIKES', { id, likes: newLikes })
        // 可以在这里添加更新点赞状态的逻辑
        article.isLiked = !isLiked
      }
    },

    // 初始化数据（可以从API获取）
    initializeArticles ({ commit }) {
      // 模拟从API加载数据
      setTimeout(() => {
        commit('SET_FETCHED', true)
      }, 1000)
    }
  }
}
